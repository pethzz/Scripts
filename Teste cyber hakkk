    let isRunning = false;

    function startBruteForce() {
        if (isRunning) return;
        
        const usernameInput = document.getElementById('username').value.trim();
        if (!usernameInput) {
            alert("Digite um nome de usuário!");
            return;
        }

        const logArea = document.getElementById('log-area');
        const statusBar = document.getElementById('status-bar');
        const btn = document.getElementById('startBtn');
        
        logArea.innerHTML = '';
        isRunning = true;
        btn.disabled = true;
        btn.innerText = "ATACANDO...";
        
        // Pega as senhas combinando lista fixa + variações do nome
        let passwordList = getExtendedList(usernameInput);
        
        // Embaralha levemente para não sempre começar pela mesma
        passwordList.sort(() => Math.random() - 0.5);

        let index = 0;
        let found = false;
        let speed = 50; // ms entre tentativas (mais rápido = mais visível, mais lento = menos detectável)

        function attempt() {
            if (!isRunning || found) return;

            if (index >= passwordList.length) {
                finishAttack("Lista esgotada.", false);
                return;
            }

            const currentPass = passwordList[index];
            
            // Simula tentativa visualmente
            const line = document.createElement('div');
            line.className = 'log-line';
            line.innerText = `[${new Date().toLocaleTimeString()}] Tentando: ${currentPass}`;
            logArea.appendChild(line);
            logArea.scrollTop = logArea.scrollHeight;

