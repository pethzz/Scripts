        body {
            margin: 0;
            padding: 0;
            background: transparent; /* Para sobrepor ao site */
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            overflow: hidden;
        }

        #pethz-window {
            width: 320px;
            background: rgba(20, 20, 30, 0.95);
            border: 1px solid #4a90e2;
            box-shadow: 0 0 20px rgba(74, 144, 226, 0.4);
            border-radius: 12px;
            color: #fff;
            position: absolute; /* Permite arrastar */
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            user-select: none;
            backdrop-filter: blur(5px);
            z-index: 9999;
        }

        #header {
            background: linear-gradient(90deg, #2c3e50, #4a90e2);
            padding: 10px 15px;
            cursor: move;
            border-top-left-radius: 12px;
            border-top-right-radius: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        #header h3 {
            margin: 0;
            font-size: 16px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .close-btn {
            color: white;
            cursor: pointer;
            font-weight: bold;
        }

        #content {
            padding: 20px;
        }

        label {
            font-size: 12px;
            color: #aaa;
            display: block;
            margin-bottom: 5px;
        }

        input[type="text"] {
            width: 90%;
            padding: 10px;
            background: #1a1a2e;
            border: 1px solid #333;
            color: #fff;
            border-radius: 6px;
            margin-bottom: 15px;
            outline: none;
        }

        input[type="text"]:focus {
            border-color: #4a90e2;
        }

        button {
            width: 100%;
            padding: 12px;
            background: #4a90e2;
            border: none;
            color: white;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            transition: 0.3s;
            text-transform: uppercase;
        }

        button:hover {
            background: #357abd;
            box-shadow: 0 0 10px #4a90e2;
        }

        button:disabled {
            background: #555;
            cursor: not-allowed;
        }

        #log-area {
            margin-top: 15px;
            height: 150px;
            background: #0f0f1a;
            border: 1px solid #333;
            border-radius: 6px;
            padding: 10px;
            overflow-y: auto;
            font-family: 'Courier New', Courier, monospace;
            font-size: 11px;
            color: #00ff00;
        }

        .log-line {
            margin: 2px 0;
            word-break: break-all;
        }

        .success {
            color: #00ff00 !important;
            font-weight: bold;
            font-size: 13px;
            background: rgba(0, 255, 0, 0.1);
            padding: 5px;
            border-radius: 4px;
            animation: pulse 1s infinite;
        }

        @keyframes pulse {
            0% { box-shadow: 0 0 5px #00ff00; }
            50% { box-shadow: 0 0 15px #00ff00; }
            100% { box-shadow: 0 0 5px #00ff00; }
        }

        #status-bar {
            margin-top: 10px;
            font-size: 11px;
            color: #888;
            text-align: right;
        }
    </style>
</head>
