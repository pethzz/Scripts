/*
 * Pethz Hub v7.0 - WebSocket Direto (Anti-Crash Total)
 * Encontra a resposta em "correctAnswers" sem varrer o JSON inteiro.
 */

(function() {
    'use strict';

    if (document.getElementById('pethz-hub')) return;

    // ============================================================
    // 1. CSS e MENU
    // ============================================================
    const style = document.createElement('style');
    style.textContent = `
        #pethz-hub {
            position: fixed; top: 10px; left: 10px; width: 220px;
            background: rgba(15, 15, 25, 0.95); border: 2px solid #8a2be2;
            border-radius: 12px; box-shadow: 0 0 15px rgba(138, 43, 226, 0.7);
            font-family: sans-serif; color: #fff; z-index: 999999; user-select: none;
        }
        .pethz-header {
            display: flex; justify-content: space-between; align-items: center;
            padding: 10px; background: #1a1a2e; border-bottom: 1px solid #8a2be2;
            border-radius: 10px 10px 0 0; cursor: move;
        }
        .pethz-title { font-weight: bold; font-size: 14px; }
        .pethz-controls button { background: none; border: none; color: #fff; font-size: 16px; cursor: pointer; margin-left: 8px; }
        .pethz-body { padding: 12px; text-align: center; }
        .pethz-btn-on {
            background: #333; color: white; border: 1px solid #8a2be2; padding: 8px 15px;
            border-radius: 6px; cursor: pointer; font-weight: bold; width: 100%;
            transition: 0.3s;
        }
        .pethz-btn-on.active { background: #00ff88; color: black; box-shadow: 0 0 10px #00ff88; border-color: #00ff88; }
        .pethz-status { font-size: 11px; margin-top: 8px; color: #ffaa00; }
        
        .pethz-highlight {
            box-shadow: 0 0 20px 5px #00ff88 !important;
            border: 3px solid #00ff88 !important;
            z-index: 9999;
        }
        .pethz-hidden {
            opacity: 0.2 !important;
            filter: blur(3px) grayscale(100%) !important;
            pointer-events: none !important;
        }
    `;
    document.head.appendChild(style);

    const menu = document.createElement('div');
    menu.id = 'pethz-hub';
    menu.innerHTML = `
        <div class="pethz-header" id="pethz-drag">
            <span class="pethz-title">Pethz WS v7</span>
            <div class="pethz-controls"><button id="pethz-close">✕</button></div>
        </div>
        <div class="pethz-body">
            <button id="pethz-toggle" class="pethz-btn-on">Ativar Show Answers</button>
            <div class="pethz-status" id="pethz-status">Aguardando...</div>
        </div>
    `;
    document.body.appendChild(menu);

    // Arrastar
    let isDragging = false, startX, startY, initL, initT;
    const dragEl = document.getElementById('pethz-drag');
    dragEl.addEventListener('mousedown', (e) => { isDragging = true; startX = e.clientX; startY = e.clientY; initL = menu.offsetLeft; initT = menu.offsetTop; });
    dragEl.addEventListener('touchstart', (e) => { isDragging = true; startX = e.touches[0].clientX; startY = e.touches[0].clientY; initL = menu.offsetLeft; initT = menu.offsetTop; });
    document.addEventListener('mousemove', (e) => { if(isDragging) { menu.style.left = (initL + e.clientX - startX) + 'px'; menu.style.top = (initT + e.clientY - startY) + 'px'; }});
    document.addEventListener('touchmove', (e) => { if(isDragging) { menu.style.left = (initL + e.touches[0].clientX - startX) + 'px'; menu.style.top = (initT + e.touches[0].clientY - startY) + 'px'; }});
    document.addEventListener('mouseup', () => isDragging = false);
    document.addEventListener('touchend', () => isDragging = false);
    document.getElementById('pethz-close').onclick = () => menu.remove();

    // ============================================================
    // 2. LÓGICA WEBSOCKET (Leve e Direta)
    // ============================================================
    let isActive = false;
    const btnToggle = document.getElementById('pethz-toggle');
    const statusText = document.getElementById('pethz-status');

    btnToggle.onclick = () => {
        isActive = !isActive;
        btnToggle.classList.toggle('active', isActive);
        btnToggle.innerText = isActive ? "Show Answers ON" : "Ativar Show Answers";
        statusText.innerText = isActive ? "Interceptando..." : "Desligado";
        
        if(!isActive) {
            document.querySelectorAll('.pethz-highlight').forEach(el => el.classList.remove('pethz-highlight'));
            document.querySelectorAll('.pethz-hidden').forEach(el => el.classList.remove('pethz-hidden'));
        }
    };

    // Substitui o WebSocket de forma segura
    const OriginalWS = window.WebSocket;
    if (!window.__pethzHookedV7) {
        window.__pethzHookedV7 = true;
        window.WebSocket = function(...args) {
            const ws = new OriginalWS(...args);
            
            ws.addEventListener('message', function(event) {
                if (!isActive) return; // Se estiver desligado no menu, nem processa
                
                try {
                    // Filtro rápido: Só processa se for mensagem de jogador
                    if (!event.data || event.data.indexOf('/service/player') === -1) return;
                    
                    const data = JSON.parse(event.data);
                    const messages = Array.isArray(data) ? data : [data];
                    
                    for (const msg of messages) {
                        if (msg.channel === '/service/player' && msg.data && msg.data.id === 1) {
                            // AQUI ESTÁ O SEGREDO: A resposta não está em "choices", está em "correctAnswers" ou "correctChoices"
                            // Não precisamos varrer o JSON inteiro, só olhar essas chaves específicas
                            
                            let content;
                            try { content = JSON.parse(msg.data.content); } catch(e) { content = msg.data.content; }
                            
                            // Tenta achar as propriedades exatas que o Kahoot usa
                            const correctArray = content.correctAnswers || content.correctChoices || content.correctAnswer;
                            
                            if (correctArray) {
                                // Pega o índice da resposta (geralmente é 0, 1, 2 ou 3)
                                let correctIndex = -1;
                                if (Array.isArray(correctArray)) {
                                    // Se for um array de booleanos [false, true, false, false]
                                    correctIndex = correctArray.indexOf(true);
                                } else if (typeof correctArray === 'number') {
                                    // Se já for o número do índice
                                    correctIndex = correctArray;
                                }

                                if (correctIndex !== -1 && correctIndex !== undefined) {
                                    applyHighlight(correctIndex);
                                }
                            }
                        }
                    }
                } catch (e) {
                    // Ignora erros de JSON inválido
                }
            });
            return ws;
        };
    }

    // ============================================================
    // 3. APLICA O EFEITO NA TELA
    // ============================================================
    function applyHighlight(index) {
        statusText.innerText = `Resposta: Alternativa ${index + 1} ✅`;
        
        // Limpa efeitos antigos
        document.querySelectorAll('.pethz-highlight').forEach(el => el.classList.remove('pethz-highlight'));
        document.querySelectorAll('.pethz-hidden').forEach(el => el.classList.remove('pethz-hidden'));

        // Como o WebSocket chega antes da tela carregar, esperamos 300ms para aplicar
        setTimeout(() => {
            const buttons = document.querySelectorAll('[data-functional-selector^="answer-"]');
            
            if (buttons.length > 0) {
                buttons.forEach((btn, i) => {
                    if (i === index) {
                        btn.classList.add('pethz-highlight'); // Brilha em verde
                    } else {
                        btn.classList.add('pethz-hidden'); // Esconde a errada
                    }
                });
            } else {
                statusText.innerText = "Tela demorou a carregar.";
            }
        }, 300);
    }

    console.log('%c[Pethz WS v7] Injetado! Leve, rápido e à prova de crashes.', 'color: #00ff88; font-weight: bold;');
})();
