/*
 * Pethz Neon - Interface KaHack + Motor Anti-Crash
 * Não precisa de ID do quiz. Funciona via WebSocket leve.
 */

(function() {
    'use strict';

    if (window.__pethzNeonActive) return;
    window.__pethzNeonActive = true;

    // ============================================================
    // 1. CSS (Estilo KaHack Neon)
    // ============================================================
    const style = document.createElement('style');
    style.textContent = `
        #pethz-neon {
            position: fixed; top: 10px; left: 10px; width: 260px;
            background: #11111a; border: 2px solid #8a2be2;
            border-radius: 10px; box-shadow: 0 0 15px rgba(138, 43, 226, 0.8);
            font-family: sans-serif; color: #fff; z-index: 999999;
            user-select: none; transition: all 0.2s;
        }
        #pethz-neon.minimized .pethz-body { display: none; }
        .pethz-header {
            display: flex; justify-content: space-between; align-items: center;
            padding: 10px 12px; background: #181826; border-bottom: 1px solid #8a2be2;
            border-radius: 8px 8px 0 0; cursor: move;
        }
        .pethz-title { font-weight: bold; font-size: 14px; color: #d8b4fe; }
        .pethz-controls button { background: none; border: none; color: #d8b4fe; font-size: 16px; cursor: pointer; margin-left: 8px; }
        .pethz-body { padding: 12px; }
        
        .pethz-toggle-row {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 12px; background: #1a1a24; padding: 8px 10px; border-radius: 6px;
            border: 1px solid #333;
        }
        .pethz-toggle-row span { font-size: 12px; font-weight: 500; }
        
        /* Switch Style */
        .pethz-switch { position: relative; display: inline-block; width: 36px; height: 20px; }
        .pethz-switch input { opacity: 0; width: 0; height: 0; }
        .pethz-slider {
            position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
            background-color: #444; transition: .3s; border-radius: 20px;
        }
        .pethz-slider:before {
            position: absolute; content: ""; height: 14px; width: 14px;
            left: 3px; bottom: 3px; background-color: white;
            transition: .3s; border-radius: 50%;
        }
        .pethz-switch input:checked + .pethz-slider { background-color: #8a2be2; box-shadow: 0 0 8px #8a2be2; }
        .pethz-switch input:checked + .pethz-slider:before { transform: translateX(16px); }

        .pethz-status { font-size: 11px; text-align: center; color: #888; margin-top: 5px; }

        /* Efeitos na tela do jogo */
        .pethz-highlight {
            box-shadow: 0 0 20px 5px #00ff88 !important;
            border: 3px solid #00ff88 !important;
            transform: scale(1.02);
            z-index: 9999;
        }
        .pethz-hidden {
            opacity: 0.15 !important;
            filter: blur(4px) grayscale(100%) !important;
            pointer-events: none !important;
        }
    `;
    document.head.appendChild(style);

    // ============================================================
    // 2. Criação do Menu
    // ============================================================
    const menu = document.createElement('div');
    menu.id = 'pethz-neon';
    menu.innerHTML = `
        <div class="pethz-header" id="pethz-drag">
            <span class="pethz-title">KaHack! Neon</span>
            <div class="pethz-controls">
                <button id="pethz-min">—</button>
                <button id="pethz-close">✕</button>
            </div>
        </div>
        <div class="pethz-body">
            <div class="pethz-toggle-row">
                <span>Auto Answer</span>
                <label class="pethz-switch">
                    <input type="checkbox" id="pethz-auto">
                    <span class="pethz-slider"></span>
                </label>
            </div>
            <div class="pethz-toggle-row">
                <span>Show Answers</span>
                <label class="pethz-switch">
                    <input type="checkbox" id="pethz-show">
                    <span class="pethz-slider"></span>
                </label>
            </div>
            <div class="pethz-status" id="pethz-status">Aguardando...</div>
        </div>
    `;
    document.body.appendChild(menu);

    // Arrastar
    let isDragging = false, startX, startY, initL, initT;
    const dragEl = document.getElementById('pethz-drag');
    dragEl.addEventListener('mousedown', (e) => { isDragging = true; startX = e.clientX; startY = e.clientY; initL = menu.offsetLeft; initT = menu.offsetTop; });
    dragEl.addEventListener('touchstart', (e) => { isDragging = true; startX = e.touches[0].clientX; startY = e.touches[0].clientY; initL = menu.offsetLeft; initT = menu.offsetTop; });
    document.addEventListener('mousemove', (e) => { if(isDragging) { menu.style.left = (initL + e.clientX - startX) + 'px'; menu.style.top = (initT + e.clientY - startY) + 'px'; }});
    document.addEventListener('touchmove', (e) => { if(isDragging) { menu.style.left = (initL + e.touches[0].clientX - startX) + 'px'; menu.style.top = (initT + e.touches[0].clientY - startY) + 'px'; }});
    document.addEventListener('mouseup', () => isDragging = false);
    document.addEventListener('touchend', () => isDragging = false);

    document.getElementById('pethz-min').onclick = () => menu.classList.toggle('minimized');
    document.getElementById('pethz-close').onclick = () => { menu.remove(); window.__pethzNeonActive = false; };

    // ============================================================
    // 3. Configurações
    // ============================================================
    let autoAnswer = false;
    let showAnswers = false;

    document.getElementById('pethz-auto').onchange = (e) => autoAnswer = e.target.checked;
    document.getElementById('pethz-show').onchange = (e) => showAnswers = e.target.checked;

    function setStatus(text) {
        document.getElementById('pethz-status').innerText = text;
    }

    // ============================================================
    // 4. Interceptação do WebSocket (Motor Anti-Crash)
    // ============================================================
    // O grande erro do GitHub era varrer o JSON inteiro. Aqui nós vamos DIRETO na propriedade certa.
    const OriginalWS = window.WebSocket;
    window.WebSocket = function(...args) {
        const ws = new OriginalWS(...args);
        
        ws.addEventListener('message', function(event) {
            // Se as opções estiverem desligadas, nem processa (economiza CPU)
            if (!autoAnswer && !showAnswers) return;
            if (!event.data || event.data.indexOf('/service/player') === -1) return;
            
            try {
                const data = JSON.parse(event.data);
                const messages = Array.isArray(data) ? data : [data];
                
                for (const msg of messages) {
                    if (msg.channel === '/service/player' && msg.data && msg.data.id === 1) {
                        let content;
                        try { content = JSON.parse(msg.data.content); } catch(e) { content = msg.data.content; }
                        
                        // O Kahoot esconde a resposta na chave "correctAnswers". Não precisamos procurar no resto!
                        let correctArray = content.correctAnswers || content.correctChoices || content.correctAnswer;
                        
                        if (correctArray) {
                            let correctIndex = -1;
                            if (Array.isArray(correctArray)) {
                                correctIndex = correctArray.indexOf(true);
                            } else if (typeof correctArray === 'number') {
                                correctIndex = correctArray;
                            }

                            if (correctIndex !== -1) {
                                executeAction(correctIndex);
                            }
                        }
                    }
                }
            } catch (e) {
                // Silencia erros para não travar a página
            }
        });
        return ws;
    };

    // ============================================================
    // 5. Execução na Tela
    // ============================================================
    function executeAction(index) {
        setStatus(`Resposta: Alternativa ${index + 1}`);
        
        // Limpa efeitos anteriores
        document.querySelectorAll('.pethz-highlight').forEach(el => el.classList.remove('pethz-highlight'));
        document.querySelectorAll('.pethz-hidden').forEach(el => el.classList.remove('pethz-hidden'));

        // Delay essencial para o celular renderizar os botões antes de aplicar o efeito
        setTimeout(() => {
            const buttons = document.querySelectorAll('[data-functional-selector^="answer-"]');
            
            if (buttons.length > 0) {
                buttons.forEach((btn, i) => {
                    if (i === index) {
                        if (showAnswers) btn.classList.add('pethz-highlight'); // Deixa verde
                        if (autoAnswer) btn.click(); // Clica
                    } else if (showAnswers) {
                        btn.classList.add('pethz-hidden'); // Apaga as erradas
                    }
                });
            } else {
                setStatus("Tela demorou a carregar.");
            }
        }, 250); // 250ms é o tempo de segurança para o mobile
    }

    console.log('%c[KaHack Neon] Injetado com sucesso! Sem ID de URL.', 'color: #d8b4fe; font-weight: bold;');
})();
