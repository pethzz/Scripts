/*
 * Pethz Hub v5.0 - Lite (100% Livre de Crashs)
 * Estratégia: Sem WebSocket, sem JSON.parse pesado. Apenas leitura leve do DOM.
 */

(function() {
    'use strict';

    // Evita dupla injeção
    if (document.getElementById('pethz-hub')) {
        console.warn('[Pethz Hub] Já está na tela.');
        return;
    }

    // ============================================================
    // 1. CSS (Leve)
    // ============================================================
    const style = document.createElement('style');
    style.textContent = `
        #pethz-hub {
            position: fixed; top: 10px; left: 10px; width: 250px;
            background: rgba(15, 15, 25, 0.95); border: 2px solid #8a2be2;
            border-radius: 12px; box-shadow: 0 0 15px rgba(138, 43, 226, 0.7);
            font-family: sans-serif; color: #fff; z-index: 999999;
            user-select: none; touch-action: none;
        }
        #pethz-hub.minimized .pethz-body { display: none; }
        .pethz-header {
            display: flex; justify-content: space-between; align-items: center;
            padding: 10px; background: #1a1a2e;
            border-bottom: 1px solid #8a2be2; border-radius: 10px 10px 0 0; cursor: move;
        }
        .pethz-title { font-weight: bold; font-size: 15px; }
        .pethz-controls button {
            background: transparent; border: none; color: #fff;
            font-size: 18px; cursor: pointer; margin-left: 8px;
        }
        .pethz-body { padding: 10px; }
        .pethz-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
        .pethz-row label { font-size: 13px; }
        .pethz-switch { position: relative; width: 40px; height: 20px; }
        .pethz-switch input { opacity: 0; width: 0; height: 0; }
        .pethz-slider {
            position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
            background-color: #555; transition: .3s; border-radius: 20px;
        }
        .pethz-slider:before {
            position: absolute; content: ""; height: 14px; width: 14px;
            left: 3px; bottom: 3px; background-color: white;
            transition: .3s; border-radius: 50%;
        }
        .pethz-switch input:checked + .pethz-slider { background-color: #8a2be2; }
        .pethz-switch input:checked + .pethz-slider:before { transform: translateX(20px); }
        .pethz-highlight {
            box-shadow: 0 0 15px 4px #00ff88 !important;
            border: 3px solid #00ff88 !important;
        }
        .pethz-status { font-size: 11px; margin-top: 5px; color: #ffaa00; text-align: center; }
    `;
    document.head.appendChild(style);

    // ============================================================
    // 2. MENU HTML
    // ============================================================
    const menu = document.createElement('div');
    menu.id = 'pethz-hub';
    menu.innerHTML = `
        <div class="pethz-header" id="pethz-drag-handle">
            <span class="pethz-title">Pethz Hub v5 Lite</span>
            <div class="pethz-controls">
                <button id="pethz-minimize">—</button>
                <button id="pethz-close">✕</button>
            </div>
        </div>
        <div class="pethz-body">
            <div class="pethz-row">
                <label>Auto Answer</label>
                <label class="pethz-switch">
                    <input type="checkbox" id="pethz-auto-answer">
                    <span class="pethz-slider"></span>
                </label>
            </div>
            <div class="pethz-row">
                <label>Show Answers</label>
                <label class="pethz-switch">
                    <input type="checkbox" id="pethz-show-answers">
                    <span class="pethz-slider"></span>
                </label>
            </div>
            <div class="pethz-status" id="pethz-status">Monitorando...</div>
        </div>
    `;
    document.body.appendChild(menu);

    // Arrastar
    let isDragging = false, startX, startY, initialLeft, initialTop;
    const dragHandle = document.getElementById('pethz-drag-handle');
    const startDrag = (e) => {
        if (e.target.closest('.pethz-controls')) return;
        isDragging = true;
        const cx = e.touches ? e.touches[0].clientX : e.clientX;
        const cy = e.touches ? e.touches[0].clientY : e.clientY;
        startX = cx; startY = cy;
        initialLeft = menu.offsetLeft; initialTop = menu.offsetTop;
    };
    const onDrag = (e) => {
        if (!isDragging) return;
        if (e.cancelable) e.preventDefault();
        const cx = e.touches ? e.touches[0].clientX : e.clientX;
        const cy = e.touches ? e.touches[0].clientY : e.clientY;
        menu.style.left = (initialLeft + cx - startX) + 'px';
        menu.style.top = (initialTop + cy - startY) + 'px';
    };
    const stopDrag = () => { isDragging = false; };

    dragHandle.addEventListener('mousedown', startDrag);
    dragHandle.addEventListener('touchstart', startDrag, { passive: false });
    document.addEventListener('mousemove', onDrag);
    document.addEventListener('touchmove', onDrag, { passive: false });
    document.addEventListener('mouseup', stopDrag);
    document.addEventListener('touchend', stopDrag);

    document.getElementById('pethz-minimize').onclick = () => menu.classList.toggle('minimized');
    document.getElementById('pethz-close').onclick = () => {
        menu.remove();
        if (window.pethzInterval) clearInterval(window.pethzInterval);
    };

    // ============================================================
    // 3. LÓGICA PRINCIPAL (Polling Leve - Sem WebSocket)
    // ============================================================
    let autoAnswerEnabled = false;
    let showAnswersEnabled = false;
    let lastQuestionText = "";
    let currentCorrectIndex = null;

    document.getElementById('pethz-auto-answer').onchange = (e) => autoAnswerEnabled = e.target.checked;
    document.getElementById('pethz-show-answers').onchange = (e) => showAnswersEnabled = e.target.checked;

    // Função que roda a cada 300ms (super leve, não trava)
    window.pethzInterval = setInterval(() => {
        try {
            // 1. Procura o texto da pergunta na tela para saber se mudou
            const questionEl = document.querySelector('[data-functional-selector="question-title"], .question-title__Title-sc-12qj0yr-1');
            if (!questionEl) return; // Se não tem pergunta na tela, ignora

            const questionText = questionEl.innerText.trim();
            
            // Se a pergunta mudou, reseta o estado
            if (questionText !== lastQuestionText && questionText !== "") {
                lastQuestionText = questionText;
                currentCorrectIndex = null;
                document.querySelectorAll('.pethz-highlight').forEach(el => el.classList.remove('pethz-highlight'));
                
                // Tenta achar a resposta lendo os "segredos" do HTML
                const buttons = document.querySelectorAll('[data-functional-selector^="answer-"]');
                
                if (buttons.length > 0) {
                    document.getElementById('pethz-status').innerText = "Analisando...";
                    
                    // O Kahoot às vezes deixa pistas no HTML (classes, atributos)
                    for (let i = 0; i < buttons.length; i++) {
                        const btn = buttons[i];
                        // Procura por classes ou atributos que indiquem a resposta certa
                        if (
                            btn.getAttribute('data-correct') === 'true' ||
                            btn.classList.contains('correct') ||
                            btn.innerHTML.includes('correct') ||
                            btn.getAttribute('aria-label') === 'Correct'
                        ) {
                            currentCorrectIndex = i;
                            break;
                        }
                    }

                    // Se achou a resposta e as opções estão ativadas
                    if (currentCorrectIndex !== null) {
                        document.getElementById('pethz-status').innerText = `Resposta: Alternativa ${currentCorrectIndex + 1}`;
                        const correctBtn = document.querySelector(`[data-functional-selector="answer-${currentCorrectIndex}"]`);
                        
                        if (correctBtn) {
                            if (showAnswersEnabled) correctBtn.classList.add('pethz-highlight');
                            if (autoAnswerEnabled) correctBtn.click();
                        }
                    } else {
                        document.getElementById('pethz-status').innerText = "Sem dica no HTML";
                    }
                }
            }
        } catch (err) {
            // Se der qualquer erro, ignora e continua rodando sem travar
            console.warn("[Pethz] Ignorando erro interno:", err);
        }
    }, 300); // 300ms é um intervalo seguro para não sobrecarregar a CPU

    console.log('%c[Pethz Hub v5] Modo Lite ativado. Sem WebSocket, sem crashes.', 'color: #00ff88; font-weight: bold;');
})();
