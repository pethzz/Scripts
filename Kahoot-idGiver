/*
 * Pethz Hub - Menu flutuante para Kahoot
 * Funcionalidades: Auto Answer e Show Answers
 * Design: Neon escuro, arrastável, minimizável
 * Uso: Cole este código no console do navegador (F12 > Console) antes de entrar na partida.
 */

(function() {
    'use strict';

    // ============================================================
    // 1. INJEÇÃO DE CSS (TEMA NEON ESCURO)
    // ============================================================
    const style = document.createElement('style');
    style.textContent = `
        #pethz-hub {
            position: fixed;
            top: 20px;
            left: 20px;
            width: 300px;
            background: rgba(15, 15, 25, 0.95);
            border: 2px solid #8a2be2;
            border-radius: 12px;
            box-shadow: 0 0 15px rgba(138, 43, 226, 0.7);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #e0e0ff;
            z-index: 99999;
            user-select: none;
            transition: all 0.3s ease;
        }
        #pethz-hub.minimized .pethz-body { display: none; }
        .pethz-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 15px;
            background: linear-gradient(90deg, #1a1a2e, #16213e);
            border-bottom: 1px solid #8a2be2;
            border-radius: 10px 10px 0 0;
            cursor: move;
        }
        .pethz-title {
            font-weight: bold;
            font-size: 18px;
            text-shadow: 0 0 8px #8a2be2;
        }
        .pethz-controls button {
            background: transparent;
            border: none;
            color: #e0e0ff;
            font-size: 18px;
            cursor: pointer;
            margin-left: 10px;
            transition: color 0.2s;
        }
        .pethz-controls button:hover { color: #8a2be2; }
        .pethz-body { padding: 15px; }
        .pethz-toggle {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }
        .pethz-toggle label { font-size: 14px; }
        .pethz-switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 24px;
        }
        .pethz-switch input { opacity: 0; width: 0; height: 0; }
        .pethz-slider {
            position: absolute;
            cursor: pointer;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: #333;
            transition: .4s;
            border-radius: 24px;
        }
        .pethz-slider:before {
            position: absolute;
            content: "";
            height: 18px; width: 18px;
            left: 3px; bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }
        .pethz-switch input:checked + .pethz-slider { background-color: #8a2be2; }
        .pethz-switch input:checked + .pethz-slider:before { transform: translateX(26px); }
        .pethz-highlight {
            box-shadow: 0 0 20px 5px #8a2be2 !important;
            border: 2px solid #8a2be2 !important;
            transition: box-shadow 0.3s ease-in-out;
        }
    `;
    document.head.appendChild(style);

    // ============================================================
    // 2. CRIAÇÃO DO MENU FLUTUANTE
    // ============================================================
    const menu = document.createElement('div');
    menu.id = 'pethz-hub';
    menu.innerHTML = `
        <div class="pethz-header" id="pethz-drag-handle">
            <span class="pethz-title">Pethz Hub</span>
            <div class="pethz-controls">
                <button id="pethz-minimize">—</button>
                <button id="pethz-close">✕</button>
            </div>
        </div>
        <div class="pethz-body">
            <div class="pethz-toggle">
                <label for="pethz-auto-answer">Auto Answer</label>
                <label class="pethz-switch">
                    <input type="checkbox" id="pethz-auto-answer">
                    <span class="pethz-slider"></span>
                </label>
            </div>
            <div class="pethz-toggle">
                <label for="pethz-show-answers">Show Answers</label>
                <label class="pethz-switch">
                    <input type="checkbox" id="pethz-show-answers">
                    <span class="pethz-slider"></span>
                </label>
            </div>
        </div>
    `;
    document.body.appendChild(menu);

    // ============================================================
    // 3. FUNCIONALIDADES DO MENU: ARRASTAR, MINIMIZAR, FECHAR
    // ============================================================
    const dragHandle = document.getElementById('pethz-drag-handle');
    let isDragging = false, offsetX, offsetY;

    dragHandle.addEventListener('mousedown', (e) => {
        isDragging = true;
        offsetX = e.clientX - menu.getBoundingClientRect().left;
        offsetY = e.clientY - menu.getBoundingClientRect().top;
    });

    document.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        menu.style.left = (e.clientX - offsetX) + 'px';
        menu.style.top = (e.clientY - offsetY) + 'px';
    });

    document.addEventListener('mouseup', () => { isDragging = false; });

    document.getElementById('pethz-minimize').addEventListener('click', () => {
        menu.classList.toggle('minimized');
    });

    document.getElementById('pethz-close').addEventListener('click', () => {
        menu.remove();
        // Restaura o WebSocket original (opcional)
        if (window.WebSocket !== OriginalWebSocket) {
            window.WebSocket = OriginalWebSocket;
        }
    });

    // ============================================================
    // 4. VARIÁVEIS DE ESTADO E DADOS DO QUIZ
    // ============================================================
    let autoAnswerEnabled = false;
    let showAnswersEnabled = false;
    let currentCorrectAnswerIndex = null;
    let quizData = null; // Armazenará os dados do quiz (perguntas e respostas)

    // Tenta extrair o ID do quiz da URL (ex: ?quizId=xxxx)
    const urlParams = new URLSearchParams(window.location.search);
    const quizId = urlParams.get('quizId');

    // Busca os dados do quiz na API pública do Kahoot (usado para saber a resposta correta)
    async function fetchQuizData(id) {
        if (!id) return;
        try {
            const response = await fetch(`https://create.kahoot.it/rest/kahoots/${id}/card/?includeKahoot=true`);
            if (!response.ok) throw new Error('Falha na resposta da API');
            const data = await response.json();
            // A estrutura pode variar; geralmente os dados estão em data.kahoot ou data.quiz
            quizData = data.kahoot || data.quiz || data;
            console.log('[Pethz Hub] Dados do quiz carregados com sucesso.');
        } catch (err) {
            console.warn('[Pethz Hub] Não foi possível obter os dados do quiz:', err.message);
        }
    }

    if (quizId) {
        fetchQuizData(quizId);
    } else {
        console.warn('[Pethz Hub] ID do quiz não encontrado na URL. O Auto Answer pode não funcionar.');
    }

    // ============================================================
    // 5. INTERCEPTAÇÃO DO WEBSOCKET (OBTENÇÃO DA RESPOSTA CORRETA)
    // ============================================================
    const OriginalWebSocket = window.WebSocket;
    if (!window.__pethzWSHooked) {
        window.__pethzWSHooked = true;

        window.WebSocket = function(...args) {
            const ws = new OriginalWebSocket(...args);

            ws.addEventListener('message', (event) => {
                try {
                    const rawData = JSON.parse(event.data);
                    // As mensagens do Kahoot geralmente vêm como um array
                    const messages = Array.isArray(rawData) ? rawData : [rawData];

                    messages.forEach(msg => {
                        // Canal de eventos do jogador
                        if (msg.channel === '/service/player') {
                            const data = msg.data;
                            // ID 1 = Pergunta recebida (questionStart)
                            if (data.id === 1) {
                                const content = JSON.parse(data.content);
                                const questionIndex = content.questionIndex;

                                if (quizData && quizData.questions && quizData.questions[questionIndex]) {
                                    const choices = quizData.questions[questionIndex].choices;
                                    const correctIndex = choices.findIndex(c => c.correct);

                                    if (correctIndex !== -1) {
                                        handleQuestionStart(correctIndex);
                                    } else {
                                        console.warn('[Pethz Hub] Resposta correta não encontrada nos dados do quiz.');
                                    }
                                } else {
                                    console.warn('[Pethz Hub] Dados do quiz ainda não carregados ou pergunta inválida.');
                                }
                            }
                        }
                    });
                } catch (err) {
                    // Ignora erros de parsing (mensagens que não são JSON)
                }
            });

            return ws;
        };
    }

    // ============================================================
    // 6. LÓGICA DE AUTO ANSWER E SHOW ANSWERS
    // ============================================================
    function handleQuestionStart(correctIndex) {
        currentCorrectAnswerIndex = correctIndex;

        // Remove destaques anteriores
        document.querySelectorAll('.pethz-highlight').forEach(el => el.classList.remove('pethz-highlight'));

        // Se Show Answers estiver ativo, destaca a resposta correta
        if (showAnswersEnabled) {
            const answerSelector = `[data-functional-selector="answer-${correctIndex}"]`;
            const answerElement = document.querySelector(answerSelector);
            if (answerElement) {
                answerElement.classList.add('pethz-highlight');
            }
        }

        // Se Auto Answer estiver ativo, clica na resposta correta
        if (autoAnswerEnabled) {
            const answerSelector = `[data-functional-selector="answer-${correctIndex}"]`;
            const answerElement = document.querySelector(answerSelector);
            if (answerElement) {
                answerElement.click();
            } else {
                console.warn('[Pethz Hub] Elemento da resposta correta não encontrado no DOM.');
            }
        }
    }

    // ============================================================
    // 7. CONEXÃO DOS TOGGLES AOS EVENTOS
    // ============================================================
    document.getElementById('pethz-auto-answer').addEventListener('change', (e) => {
        autoAnswerEnabled = e.target.checked;
        // Se ativado e já houver uma resposta correta conhecida, clica imediatamente
        if (autoAnswerEnabled && currentCorrectAnswerIndex !== null) {
            const answerSelector = `[data-functional-selector="answer-${currentCorrectAnswerIndex}"]`;
            const answerElement = document.querySelector(answerSelector);
            if (answerElement) answerElement.click();
        }
    });

    document.getElementById('pethz-show-answers').addEventListener('change', (e) => {
        showAnswersEnabled = e.target.checked;

        if (showAnswersEnabled && currentCorrectAnswerIndex !== null) {
            const answerSelector = `[data-functional-selector="answer-${currentCorrectAnswerIndex}"]`;
            const answerElement = document.querySelector(answerSelector);
            if (answerElement) answerElement.classList.add('pethz-highlight');
        } else if (!showAnswersEnabled) {
            // Remove todos os destaques
            document.querySelectorAll('.pethz-highlight').forEach(el => el.classList.remove('pethz-highlight'));
        }
    });

    console.log('[Pethz Hub] Script carregado. Arraste pelo cabeçalho, minimize ou feche conforme necessário.');
})();
